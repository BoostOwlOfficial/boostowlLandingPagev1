# =============================================================================
# BoostOwl Careers — environment variables
#
# This file is a TEMPLATE. It is committed on purpose and contains no secrets.
#
#   PRODUCTION  ->  Vercel Dashboard > Project > Settings > Environment Variables
#   LOCAL DEV   ->  copy to .env.local and fill in
#                     cp .env.example .env.local
#                   .env.local is gitignored. NEVER commit it.
#
# Or, once the project is linked, pull the real values down:
#   vercel link
#   vercel env pull .env.local
#
# WARNING: do NOT prefix any of these with NEXT_PUBLIC_ or VITE_. Those
# prefixes are the opt-in to bundling a value into the browser. Only
# TURNSTILE_SITE_KEY is public, and it is exposed deliberately by
# api/careers/jobs.js — never by a build-time prefix.
#
# Full reference: CAREERS-ADMIN.md §2
# =============================================================================


# --- Supabase -----------------------------------------------------------
# Dashboard > Project Settings > API
#
# SUPABASE_SERVICE_KEY is the `service_role` key. It BYPASSES row-level
# security and can read every application. It must exist only here and in
# Vercel. Never in the browser, never in git, never in a client-side admin app.
# (The `anon` key is not used anywhere — RLS is on with zero policies, so it
# can do nothing at all.)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...


# --- Upstash Redis (rate limiting) --------------------------------------
# console.upstash.com > your database > REST API
# Use the REST url/token, NOT the redis:// connection string — we speak HTTP.
# If these are unset the limiter falls back to counting rows in Postgres:
# slower, same limits, never silently off.
UPSTASH_REDIS_REST_URL=https://xxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...


# --- Cloudflare Turnstile (bot protection) ------------------------------
# dash.cloudflare.com > Turnstile > add site for boostowl.io (+ localhost)
#
# SITE key is public: api/careers/jobs.js sends it to the browser so the
# widget can render. SECRET key is server-only.
#
# LOCAL TESTING — Cloudflare publishes dummy keys that need no real domain:
#   always passes : site 1x00000000000000000000AA
#                   secret 1x0000000000000000000000000000000AA
#   always blocks : site 2x00000000000000000000AB
#                   secret 2x0000000000000000000000000000000AA
#   forces challenge: site 3x00000000000000000000FF
# Or set config.turnstile_enabled = false in Supabase to skip captcha entirely.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# --- Resend (email) ------------------------------------------------------
# resend.com > API Keys. Verify the boostowl.io domain first or sends fail.
# Optional: without it, applications still save; notify_status stays 'pending'
# and the daily cron retries.
RESEND_API_KEY=re_...


# --- AI scoring (provider-agnostic) -------------------------------------
# The VENDOR is chosen in the database, not here:
#   config.ai_provider   anthropic | openai | google | openai_compatible
#   config.ai_model      model id for that provider
#   config.ai_base_url   required for openai_compatible (Groq, OpenRouter,
#                        Together, DeepSeek, Ollama, LM Studio, vLLM...)
#   config.ai_price_in_per_mtok / ai_price_out_per_mtok   for cost tracking
#
# Here you only supply a key. AI_API_KEY is used by whichever provider is
# selected. The provider-specific aliases below take precedence if set.
# All optional: scoring stays off until config.ai_scoring_enabled = true.
AI_API_KEY=

# Optional aliases — set one of these instead if you juggle several providers.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
#
# Endpoints needing no auth (Ollama, LM Studio) can leave all of these blank.

# --- Optional: pick the provider from here instead of the config table -------
# PRECEDENCE:  env var  >  config table row  >  built-in default
#
# NOTE: turning scoring ON/OFF is NOT here. That stays a database decision:
#   config.ai_scoring_enabled  (master)  +  jobs.ai_enabled  (per role)
# so there is exactly one place to look and no deploy needed to flip it.
#
# A blank value here is treated as "not set", so it will NOT wipe out a real
# config row. Uncomment only what you want to force.
#
# TRADE-OFF: an env change needs a REDEPLOY on Vercel; a config row is picked
# up within 60s. Use env for local/preview, config for switching production.
#
#   AI_PROVIDER=anthropic          # anthropic | openai | google | openai_compatible
#   AI_MODEL=claude-haiku-4-5
#   AI_BASE_URL=                   # required for openai_compatible
#   AI_PRICE_IN_PER_MTOK=1.0       # for cost tracking
#   AI_PRICE_OUT_PER_MTOK=5.0
#
# Examples:
#   Groq    AI_PROVIDER=openai_compatible  AI_BASE_URL=https://api.groq.com/openai
#   Ollama  AI_PROVIDER=openai_compatible  AI_BASE_URL=http://localhost:11434
#   Gemini  AI_PROVIDER=google



# --- Secrets we generate ourselves --------------------------------------
# Generate each with:   openssl rand -hex 32
#
# FORM_TOKEN_SECRET  signs the form token (dwell time + one-time nonce).
#                    If unset, /api/careers/jobs issues no token and the form
#                    disables itself rather than letting someone fill it in
#                    for ten minutes and fail.
# IP_HASH_SALT       we store sha256(ip + salt), never a raw IP. Rotating this
#                    invalidates every existing ip_hash, INCLUDING any
#                    config.blocked_ip_hashes entries.
# CRON_SECRET        Vercel Cron sends this as `Authorization: Bearer <value>`.
#                    Without it anyone can hit /api/careers/cron/* and drain
#                    your AI budget.
FORM_TOKEN_SECRET=
IP_HASH_SALT=
CRON_SECRET=
